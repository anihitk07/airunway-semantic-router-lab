# --- Personal / environment-specific configuration ---
# The personal config holds your Azure subscription, resource group, cluster
# name and other environment-specific values. It is intentionally not tracked.
# Copy config/lab.example.psd1 -> config/lab.psd1 locally.
config/lab.psd1

# --- Local runtime artifacts ---
# Test/spike output regenerated by scripts/11; safe to ignore.
tests/compatibility-spike-results.json

# --- Secrets and credentials ---
*.env
.env
.env.*
*.kubeconfig
kubeconfig
*.pem
*.key
*.crt
*.pfx
*.p12
*.tfstate
*.tfstate.*
*.tfvars
*credentials*
*secret*

# --- LinkedIn draft (kept local only) ---
LINKEDIN.md

# --- Temp and tooling files ---
*.log
*.tmp
*.swp
*.swo
*.bak
*.orig
.DS_Store
Thumbs.db

# --- IDE / editor ---
.vscode/
.idea/
*.user
*.suo
*.code-workspace

# --- PowerShell module/state ---
*.psd1.lock
PSScriptAnalyzerSettings.psd1

# --- Helm / Kubernetes local working files ---
charts/
helm-values-*.yaml
*-rendered.yaml

